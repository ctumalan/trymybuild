{
  "name": "trymybuild",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "prepare:site": "node scripts/prepare-site.mjs",
    "dev": "npm run prepare:site && astro dev --host 127.0.0.1",
    "build": "npm run prepare:site && astro build && node scripts/migrate-public-app-links.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.10",
    "@sparticuz/chromium": "149.0.0",
    "@supabase/supabase-js": "2.115.0",
    "@workos-inc/node": "10.13.0",
    "astro": "7.3.1",
    "ipaddr.js": "2.5.0",
    "puppeteer-core": "25.10.0",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
