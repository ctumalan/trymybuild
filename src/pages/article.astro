---
import EditorialLayout from '../layouts/EditorialLayout.astro';
import { articles, articleMonth, formatArticleDate } from '../data/articles';
const [latest, ...archive] = articles;
const months = [...new Set(archive.map(post => articleMonth(post.date)))];
---
<EditorialLayout title="Articles for app creators" description="Practical guides to finding app testers, asking better questions, and turning feedback into a better build." path="/article">
  <div class="article-library">
    <header class="library-intro">
      <p class="eyebrow">The maker’s reading room</p>
      <h1>A little guidance.<br/>A <em>better next build.</em></h1>
      <p>Finding your first testers. Asking better questions.<br class="desktop-break"/> Making something people want to come back to.</p>
    </header>
    <section aria-labelledby="latest-heading">
      <div class="section-heading"><h2 id="latest-heading">Fresh from TryMyBuild</h2><span>{articles.length} articles & guides · Newest first</span></div>
      <article class="featured-post">
        <a href={latest.href} class="featured-image" tabindex="-1" aria-hidden="true"><img src={latest.image} srcset={`${latest.image.replace('.webp','-768.webp')} 768w, ${latest.image} 1536w`} sizes="(max-width:800px) 95vw, 50vw" width="1536" height="1024" alt="" fetchpriority="high"/></a>
        <div class="featured-copy">
          <p class="post-meta"><span>{latest.type}</span><time datetime={latest.date}>{formatArticleDate(latest.date)}</time></p>
          <h3><a href={latest.href}>{latest.title}</a></h3>
          <p class="post-description">{latest.description}</p>
          <div class="post-bottom"><span>{latest.readTime}</span><a href={latest.href} aria-label={`Read ${latest.title}`}>Read the guide <span aria-hidden="true">↗</span></a></div>
        </div>
      </article>
    </section>
    <section class="archive" aria-labelledby="archive-heading">
      <div class="section-heading"><h2 id="archive-heading">Keep reading</h2><span>Browse by publication date</span></div>
      {months.map(month => <section class="month-group" aria-label={month}>
        <h3 class="month-heading">{month}</h3>
        <div class="post-grid">{archive.filter(post => articleMonth(post.date) === month).map(post => <article class="post-card">
          <a class="card-image" href={post.href} tabindex="-1" aria-hidden="true"><img src={post.image.replace('.webp','-768.webp')} width="768" height="512" alt="" loading="lazy"/></a>
          <div class="card-copy"><p class="post-meta"><span>{post.type}</span><time datetime={post.date}>{formatArticleDate(post.date)}</time></p>
          <h4><a href={post.href}>{post.title}</a></h4><p class="post-description">{post.description}</p>
          <div class="post-bottom"><span>{post.readTime}</span><a href={post.href} aria-label={`Read ${post.title}`}>Read {post.type === 'Quick start' ? 'the checklist' : 'the article'} <span aria-hidden="true">↗</span></a></div></div>
        </article>)}</div>
      </section>)}
    </section>
    <aside class="library-invite"><div><p class="eyebrow">Put it into practice</p><h2>A real person can spot what you’ve stopped seeing.</h2><p>Share your build and start a feedback conversation with another creator.</p></div><a href="/?listing=settings">Get feedback on your app →</a></aside>
  </div>
</EditorialLayout>
<script>
// Preserve links to sections of the article formerly served at /article.
const legacySections = new Set(['network','communities','listing','public','fit','followup']);
if (legacySections.has(location.hash.slice(1))) location.replace('/article/find-beta-users-with-no-audience' + location.hash);
</script>
<style>
  .article-library { max-width:1160px; margin:auto; padding:0 28px; }
  .library-intro { padding:68px 0 54px; max-width:800px; }
  .library-intro h1 { font:400 clamp(42px,5.3vw,70px)/1.08 Georgia,serif; letter-spacing:-.045em; margin:20px 0; color:#2e2633; }
  .library-intro h1 em { color:#76508b; font-weight:400; }
  .library-intro>p:last-child { color:#716775; font-size:18px; line-height:1.65; margin:22px 0 0; }
  .section-heading { display:flex; align-items:baseline; justify-content:space-between; gap:16px; border-bottom:1px solid #ded9d0; padding-bottom:17px; margin-bottom:24px; }
  .section-heading h2 { font-size:17px; letter-spacing:-.025em; margin:0; }
  .section-heading>span { font-size:12px; color:#7c707f; }
  .featured-post { display:grid; grid-template-columns:1.15fr 1fr; border:1px solid #e3dce7; border-radius:18px; overflow:hidden; background:#fff; }
  .featured-image { display:flex; background:#f4effb; }
  .featured-image img { display:block; width:100%; height:100%; object-fit:cover; aspect-ratio:3/2; }
  .featured-copy { padding:36px; display:flex; flex-direction:column; justify-content:center; }
  .post-meta { display:flex; align-items:center; gap:10px 20px; flex-wrap:wrap; font-size:11px; line-height:1.6; margin:0; color:#827587; }
  .post-meta>span { color:#76508b; font-weight:700; }
  .featured-copy h3 { font:400 clamp(26px,3vw,38px)/1.16 Georgia,serif; letter-spacing:-.03em; margin:18px 0 14px; }
  h3 a,h4 a { color:inherit; text-decoration:none; }
  h3 a:hover,h4 a:hover { color:#76508b; text-decoration:underline; }
  .post-description { font-size:15px; line-height:1.75; color:#716775; margin:0; }
  .post-bottom { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-top:28px; font-size:12px; color:#8a7d8e; }
  .post-bottom a { color:#76508b; font-size:13px; font-weight:700; text-decoration:none; }
  .post-bottom a:hover { text-decoration:underline; }
  .archive { margin-top:60px; }
  .month-heading { font-size:12px; text-transform:uppercase; letter-spacing:.12em; color:#8a7d8e; margin:28px 0 18px; }
  .post-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:28px; }
  .post-card { border:1px solid #e5dfe8; border-radius:14px; overflow:hidden; background:white; display:flex; flex-direction:column; }
  .card-image { display:block; aspect-ratio:16/9; overflow:hidden; }
  .card-image img { display:block; width:100%; height:100%; object-fit:cover; }
  .card-copy { padding:28px; display:flex; flex-direction:column; flex:1; }
  .card-copy h4 { font:400 28px/1.2 Georgia,serif; letter-spacing:-.025em; margin:16px 0 14px; }
  .card-copy .post-bottom { margin-top:auto; padding-top:28px; }
  .library-invite { display:flex; align-items:center; justify-content:space-between; gap:28px; background:#eee6f3; border-radius:14px; padding:32px; margin-top:54px; }
  .library-invite h2 { font:400 27px/1.25 Georgia,serif; letter-spacing:-.02em; max-width:540px; margin:12px 0; }
  .library-invite p:last-child { font-size:14px; line-height:1.6; color:#716775; margin:0; }
  .library-invite>a { flex-shrink:0; background:#76508b; border-radius:30px; color:#fff; font-size:12px; font-weight:700; padding:16px 21px; text-decoration:none; }
  @media(max-width:800px){ .featured-post { grid-template-columns:1fr; } .featured-image img { height:auto; aspect-ratio:3/2; } .featured-copy { padding:28px; } .library-invite { align-items:flex-start; flex-direction:column; } }
  @media(max-width:550px){ .article-library { padding:0 20px; } .library-intro { padding:40px 0 36px; } .library-intro>p:last-child { font-size:16px; } .desktop-break { display:none; } .section-heading { align-items:flex-start; flex-direction:column; gap:8px; } .post-grid { grid-template-columns:1fr; gap:22px; } .featured-copy,.card-copy { padding:24px; } .archive { margin-top:40px; } .library-invite { padding:25px; } }
</style>
